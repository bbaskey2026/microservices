# Database
DB_HOST=postgres
DB_USER=banking_user
DB_PASSWORD=banking_pass
DB_PORT=5432

AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
CARD_DB_NAME=card_db
WALLET_DB_NAME=wallet_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db
REPORTS_DB_NAME=reports_db

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Service Ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
CARD_SERVICE_PORT=3003
WALLET_SERVICE_PORT=3004
PAYMENT_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006
REPORTS_SERVICE_PORT=3007

# Service URLs (for API Gateway)
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
CARD_SERVICE_URL=http://card-service:3003
WALLET_SERVICE_URL=http://wallet-service:3004
PAYMENT_SERVICE_URL=http://payment-service:3005
NOTIFICATION_SERVICE_URL=http://notification-service:3006
REPORTS_SERVICE_URL=http://reports-service:3007